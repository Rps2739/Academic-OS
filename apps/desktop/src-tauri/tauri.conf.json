{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Academic OS",
  "version": "0.1.0",
  "identifier": "com.academicos.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Academic OS",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      },
      {
        "label": "widget-tasks",
        "title": "Tasks",
        "width": 280,
        "height": 360,
        "x": 40,
        "y": 40,
        "decorations": false,
        "transparent": true,
        "alwaysOnBottom": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": true,
        "minWidth": 220,
        "minHeight": 200
      },
      {
        "label": "widget-classes",
        "title": "Today",
        "width": 280,
        "height": 260,
        "x": 40,
        "y": 420,
        "decorations": false,
        "transparent": true,
        "alwaysOnBottom": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": true,
        "minWidth": 220,
        "minHeight": 160
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; img-src 'self' data: blob: https://*.supabase.co; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
