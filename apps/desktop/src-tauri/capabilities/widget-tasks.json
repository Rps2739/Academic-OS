{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "widget-tasks",
  "description": "Capability for the always-on-top tasks panel",
  "windows": ["widget-tasks"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position",
    "core:window:allow-current-monitor",
    "core:window:allow-outer-size",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close"
  ]
}
